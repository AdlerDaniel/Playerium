{
  "name": "playerium",
  "version": "1.7.49",
  "description": "Playerium - Modern Spotify-style local music player for PC and Android",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64 --publish never",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.js",
    "version:sync": "node scripts/sync-version.js",
    "android:assets": "node scripts/sync-assets.js",
    "test:browser": "playwright test",
    "test:desktop": "node tests/desktop/smoke.cjs",
    "realtime:build": "node scripts/build-realtime.js"
  },
  "build": {
    "appId": "com.playerium.music",
    "productName": "Playerium",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "!assets/icon-master.png",
      "build/icon.ico",
      "package.json",
      "desktop-files.js",
      "desktop-updater.js",
      "desktop-update-helper.js",
      "desktop-music.js",
      "desktop-audio.js",
      "desktop-loudness.js",
      "desktop-normalization.js",
      "desktop-original-audio.js",
      "desktop-waveform.js",
      "desktop-cloud.js",
      "desktop-cloud-http.js",
      "desktop-connect.js",
      "desktop-live.js",
      "desktop-peer-files.js",
      "desktop-peer-preview.js",
      "MUSIC-NOTICES.md",
      "desktop-realtime.js",
      "app-branding.js",
      "desktop-branding.js",
      "desktop-mini.js",
      "mini-preload.js",
      "mini-player.html"
    ],
    "extraResources": [
      {
        "from": "build/music-tools",
        "to": "music-tools"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Playerium",
      "include": "scripts/installer-branding.nsh"
    }
  },
  "keywords": [
    "playerium",
    "music",
    "player",
    "spotify",
    "local-audio",
    "electron"
  ],
  "author": "Playerium Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.0.0"
  },
  "dependencies": {
    "@supabase/realtime-js": "2.118.0",
    "music-metadata": "^11.16.1"
  }
}
